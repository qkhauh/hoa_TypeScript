type abc = number | string;
function addds(a: abc, b: abc) {
if (typeof a === 'number' && typeof b === 'number') {
        return a + b;
    }
    if (typeof a === 'string' && typeof b === 'string') {
        return a.concat(b);
    }
    throw new Error('Invalid parmeter');
}

console.log("KQ: ", adds(9, 8)); 
